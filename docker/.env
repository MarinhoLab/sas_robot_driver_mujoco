# The scene of the scene service of compose.yaml (read by docker compose from this folder; the variables of the shell
# take precedence). By default, the UMIRobot of this package.

# The folder of the scene, mounted on /scene (with the files it includes and its meshes). Relative to this folder, or
# absolute (e.g., ~/my_scenes).
SCENE_DIR=../models/umirobot
# The MJCF file of the scene, in SCENE_DIR.
SCENE_FILE=scene.xml
# The name of the robot: the prefix of its topics (/umirobot/get/joint_states, ...), and its parameters
# (config/<ROBOT_NAME>.yaml of the package: ur3e, z1 or umirobot), unless CONFIG_FILE is given.
ROBOT_NAME=umirobot
# Optional: the parameters of the robot (a YAML file in SCENE_DIR, as those in config/), for a robot without them in
# the package.
CONFIG_FILE=
