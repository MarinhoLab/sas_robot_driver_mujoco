<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sas_robot_driver_mujoco</name>
  <version>0.1.0</version>
  <description>A SAS robot driver for robots in MuJoCo scenes, simulated in the driver with cpp-interface-mujoco.</description>
  <maintainer email="juanjqouk@gmail.com">Juan Jose Quiroz Omana</maintainer>
  <license>LGPL-3.0-or-later</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>eigen</depend>
  <depend>sas_core</depend>
  <depend>sas_common</depend>
  <depend>sas_robot_driver</depend>
  <!-- cpp-interface-mujoco (https://github.com/juanjqo/cpp-interface-mujoco) is not a ROS package:
       install it before building this one. -->

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
