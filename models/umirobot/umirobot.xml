<!--
  The UMIRobot (https://mmmarinho.github.io/UMIRobot/), by Murilo M. Marinho, a 5-DoF arm of hobby servos, with
  position actuators. See README.md for the source and how the model was made.

  The bodies follow the DH parameters of the UMIRobot (umirobot_control/commons/_umirobot_csim_robot.py of
  https://github.com/mmmarinho/umirobot), so that the pose of the site end_effector is their forward kinematics,
  with the reference frame at joint 1: 1 + 0.5*E_*(-0.015469*i_ + 0.00323*j_ + 0.059873*k_) rotated by
  (0.99863, 0, 0, -0.0523359). The meshes are placed in them as in the URDF of the UMIRobot at q = 0.
-->
<mujoco model="umirobot">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <option integrator="implicitfast"/>

  <default>
    <default class="umirobot">
      <!-- armature: the inertia of the motor of the servo through its gears -->
      <joint axis="0 0 1" range="-1.570796327 1.570796327" armature="0.0005" damping="0.01"/>
      <general biastype="affine" ctrlrange="-1.570796327 1.570796327"/>
      <!-- Standard servos (joints 1 to 3) and micro servos (joints 4 and 5) -->
      <default class="servo">
        <joint actuatorfrcrange="-1 1"/>
        <general gainprm="10" biasprm="0 -10 -0.3"/>
      </default>
      <default class="micro_servo">
        <joint actuatorfrcrange="-0.324 0.324"/>
        <general gainprm="2" biasprm="0 -2 -0.1"/>
      </default>
      <default class="visual">
        <geom type="mesh" group="2" contype="0" conaffinity="0"/>
      </default>
    </default>
  </default>

  <asset>
    <material name="black" rgba="0.1 0.1 0.1 1"/>
    <material name="blue" rgba="0.2 0.65 1 1"/>
    <material name="white" rgba="1 1 1 1"/>
    <material name="yellow" rgba="1 0.86 0.4 1"/>
    <material name="navy" rgba="0 0 0.59 1"/>
    <material name="grey" rgba="0.85 0.85 1 1"/>

    <mesh file="link1_black.obj"/>
    <mesh file="link1_blue.obj"/>
    <mesh file="link1_white.obj"/>
    <mesh file="link2_black.obj"/>
    <mesh file="link2_blue.obj"/>
    <mesh file="link2_yellow.obj"/>
    <mesh file="link3_black.obj"/>
    <mesh file="link3_blue.obj"/>
    <mesh file="link3_yellow.obj"/>
    <mesh file="link4_black.obj"/>
    <mesh file="link4_blue.obj"/>
    <mesh file="link4_yellow.obj"/>
    <mesh file="link5_black.obj"/>
    <mesh file="link5_blue.obj"/>
    <mesh file="link5_navy.obj"/>
    <mesh file="link5_yellow.obj"/>
  </asset>

  <worldbody>
    <!-- The base (link 1), fixed, at the origin of the robot -->
    <body name="UMIRobot_link_1" childclass="umirobot">
      <geom class="visual" mesh="link1_black" material="black"/>
      <geom class="visual" mesh="link1_blue" material="blue"/>
      <geom class="visual" mesh="link1_white" material="white"/>
      <!-- DH frame 0, at joint 1 -->
      <body name="UMIRobot_link_2" pos="-0.015469 0.00323 0.059873" quat="0.99863 0 0 -0.0523359">
        <inertial pos="0.011697 -0.000989 0.022514" quat="0.506366 0.500018 -0.499859 0.493676" mass="0.0857661"
          diaginertia="4.54356e-05 4.18803e-05 3.27812e-05"/>
        <joint name="UMIRobot_joint_1" class="servo"/>
        <geom class="visual" mesh="link2_black" material="black" pos="0.015722 -0.001595 -0.059873" quat="0.99863 0 0 0.0523359"/>
        <geom class="visual" mesh="link2_blue" material="blue" pos="0.015722 -0.001595 -0.059873" quat="0.99863 0 0 0.0523359"/>
        <geom class="visual" mesh="link2_yellow" material="yellow" pos="0.015722 -0.001595 -0.059873" quat="0.99863 0 0 0.0523359"/>
        <!-- DH frame 1 -->
        <body name="UMIRobot_link_3" pos="0 0 0.0245" quat="0.707107 -0.707107 0 0">
          <inertial pos="0.000727646 -0.0569445 0.0370421" quat="0.706949 0.706067 -0.0310684 -0.0269673" mass="0.0511207"
            diaginertia="4.88373e-05 4.81137e-05 6.87073e-06"/>
          <joint name="UMIRobot_joint_2" class="servo"/>
          <geom class="visual" mesh="link3_black" material="black" pos="0.0157213 0.0843732 -0.00159499" quat="0.706138 0.706138 -0.0370071 0.0370069"/>
          <geom class="visual" mesh="link3_blue" material="blue" pos="0.0157213 0.0843732 -0.00159499" quat="0.706138 0.706138 -0.0370071 0.0370069"/>
          <geom class="visual" mesh="link3_yellow" material="yellow" pos="0.0157213 0.0843732 -0.00159499" quat="0.706138 0.706138 -0.0370071 0.0370069"/>
          <!-- DH frame 2 -->
          <body name="UMIRobot_link_4" pos="0 -0.0813 0" quat="0 0.707107 -0.707107 0">
            <inertial pos="-0.000127412 -0.0476083 -0.000467252" quat="0.999471 -0.0301062 0.0114886 0.00432849" mass="0.0594808"
              diaginertia="0.000127817 0.000121269 1.22307e-05"/>
            <joint name="UMIRobot_joint_3" class="servo"/>
            <geom class="visual" mesh="link4_black" material="black" pos="-0.165672 -0.0157207 0.0015954" quat="0.525482 -0.473148 0.525483 -0.473146"/>
            <geom class="visual" mesh="link4_blue" material="blue" pos="-0.165672 -0.0157207 0.0015954" quat="0.525482 -0.473148 0.525483 -0.473146"/>
            <geom class="visual" mesh="link4_yellow" material="yellow" pos="-0.165672 -0.0157207 0.0015954" quat="0.525482 -0.473148 0.525483 -0.473146"/>
            <!-- DH frame 3 -->
            <body name="UMIRobot_link_5" quat="0.707107 0.707107 0 0">
              <inertial pos="0.00157509 -0.00535248 0.147993" quat="0.656861 0.17255 0.173851 0.713117" mass="0.0263035"
                diaginertia="1.3804e-05 1.04491e-05 6.92424e-06"/>
              <joint name="UMIRobot_joint_4" class="micro_servo"/>
              <geom class="visual" mesh="link5_black" material="black" pos="-0.165672 0.00159527 0.0157208" quat="0.0370064 -0.706138 0.0370065 -0.706138"/>
              <geom class="visual" mesh="link5_blue" material="blue" pos="-0.165672 0.00159527 0.0157208" quat="0.0370064 -0.706138 0.0370065 -0.706138"/>
              <geom class="visual" mesh="link5_navy" material="navy" pos="-0.165672 0.00159527 0.0157208" quat="0.0370064 -0.706138 0.0370065 -0.706138"/>
              <geom class="visual" mesh="link5_yellow" material="yellow" pos="-0.165672 0.00159527 0.0157208" quat="0.0370064 -0.706138 0.0370065 -0.706138"/>
              <!-- DH frame 4 -->
              <body name="UMIRobot_link_6" pos="0 0 0.16519" quat="0.707107 -0.707107 0 0">
                <inertial pos="0.00159643 0.000278503 -0.0101152" quat="0.709565 -0.0260526 -0.021037 0.703844" mass="0.000785398"
                  diaginertia="1.14537e-08 1.14537e-08 9.81748e-09"/>
                <joint name="UMIRobot_joint_5" class="micro_servo"/>
                <!-- The rotating mount of the gripper (the grippers are designed by the students) -->
                <geom class="visual" type="cylinder" size="0.005 0.005" material="grey" pos="0.00159643 0.000278503 -0.0101152"
                  quat="0.709565 -0.0260526 -0.021037 0.703844"/>
                <!-- The end effector: DH frame 5, the frame of the forward kinematics of the DH parameters -->
                <site name="end_effector" size="0.005"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <general class="servo" name="UMIRobot_joint_1" joint="UMIRobot_joint_1"/>
    <general class="servo" name="UMIRobot_joint_2" joint="UMIRobot_joint_2"/>
    <general class="servo" name="UMIRobot_joint_3" joint="UMIRobot_joint_3"/>
    <general class="micro_servo" name="UMIRobot_joint_4" joint="UMIRobot_joint_4"/>
    <general class="micro_servo" name="UMIRobot_joint_5" joint="UMIRobot_joint_5"/>
  </actuator>

  <keyframe>
    <!-- q = 0: the upper arm up, the forearm forward -->
    <key name="home" qpos="0 0 0 0 0" ctrl="0 0 0 0 0"/>
  </keyframe>
</mujoco>
